API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/resumable_upload_kit_test
DATABASE_POOL_SIZE=10
UPLOAD_DIRECTORY=./var/uploads
UPLOAD_CLEANUP_BATCH_SIZE=50
UPLOAD_CLEANUP_CLAIM_MS=300000
UPLOAD_CLEANUP_CONCURRENCY=4
UPLOAD_CLEANUP_INTERVAL_MS=60000
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=resumable-upload-api
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
