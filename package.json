{
  "name": "resumable-upload-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Production-minded resumable uploads for React and Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasiliy-strecker/resumable-upload-kit.git"
  },
  "bugs": {
    "url": "https://github.com/wasiliy-strecker/resumable-upload-kit/issues"
  },
  "homepage": "https://github.com/wasiliy-strecker/resumable-upload-kit#readme",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "fast-check": "4.9.0",
    "prettier": "3.9.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
