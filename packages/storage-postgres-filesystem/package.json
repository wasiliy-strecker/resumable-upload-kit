{
  "name": "@resumable-upload-kit/storage-postgres-filesystem",
  "version": "0.1.0",
  "description": "PostgreSQL coordination and streaming filesystem blobs for Resumable Upload Kit",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resumable-upload-kit/protocol": "workspace:*",
    "@resumable-upload-kit/server": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "fastify": "5.11.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
