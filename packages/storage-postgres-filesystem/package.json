{
  "name": "@resumable-upload-kit/storage-postgres-filesystem",
  "version": "0.1.0",
  "description": "PostgreSQL coordination and streaming filesystem blobs for Resumable Upload Kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasiliy-strecker/resumable-upload-kit.git",
    "directory": "packages/storage-postgres-filesystem"
  },
  "homepage": "https://github.com/wasiliy-strecker/resumable-upload-kit/tree/main/packages/storage-postgres-filesystem#readme",
  "bugs": {
    "url": "https://github.com/wasiliy-strecker/resumable-upload-kit/issues"
  },
  "keywords": [
    "filesystem",
    "postgresql",
    "resumable",
    "storage",
    "upload"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resumable-upload-kit/protocol": "workspace:*",
    "@resumable-upload-kit/server": "workspace:*",
    "@types/pg": "8.21.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "fastify": "5.11.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
