{
  "name": "@resumable-upload-kit/client",
  "version": "0.1.0",
  "description": "Framework-independent tus browser client with restart-safe checkpoints",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasiliy-strecker/resumable-upload-kit.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/wasiliy-strecker/resumable-upload-kit/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/wasiliy-strecker/resumable-upload-kit/issues"
  },
  "keywords": [
    "browser",
    "resumable",
    "tus",
    "typescript",
    "upload"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resumable-upload-kit/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
