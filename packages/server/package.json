{
  "name": "@resumable-upload-kit/server",
  "version": "0.1.0",
  "description": "Framework-neutral resumable upload orchestration with a Fastify tus adapter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasiliy-strecker/resumable-upload-kit.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/wasiliy-strecker/resumable-upload-kit/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/wasiliy-strecker/resumable-upload-kit/issues"
  },
  "keywords": [
    "fastify",
    "nodejs",
    "resumable",
    "tus",
    "upload"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resumable-upload-kit/protocol": "workspace:*"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0 <6"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "fastify": "5.11.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
